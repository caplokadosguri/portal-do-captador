# Copie para .env.local e preencha com os dados do projeto no Supabase (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública ("anon" ou "publishable"). Nunca coloque aqui a chave secreta (service_role).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "sim" para mostrar o botão "Entrar com Google" (configure o Google em Authentication > Providers).
NEXT_PUBLIC_LOGIN_GOOGLE=nao
